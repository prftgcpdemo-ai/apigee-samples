pipeline {
    agent any

    parameters {
        string(name: 'PROJECT', defaultValue: 'corp-apigee')
        string(name: 'REGION', defaultValue: 'us-central1')
        string(name: 'MODEL_ID', defaultValue: 'gemini-2.0-flash')
        string(name: 'EMBEDDINGS_MODEL_ID', defaultValue: 'text-embedding-005')
        string(name: 'NEAREST_NEIGHBOR_DISTANCE', defaultValue: '0.95')
        string(name: 'CACHE_ENTRY_TTL_SEC', defaultValue: '60')
        string(name: 'APIGEE_ENV', defaultValue: 'dev')
        string(name: 'API_NAME', defaultValue: 'llm-token-limits')
        string(name: 'APIGEE_HOST', defaultValue: 'api.prftgcpdemo.ai')
        string(name: 'SERVICE_ACCOUNT', defaultValue: 'api-proxy-logging@corp-apigee.iam.gserviceaccount.com')
        booleanParam(name: 'CREATE_INDEX', defaultValue: false)
    }

    stages {
        stage('Configure Apigee Credentials') {
            steps {
                script {
                    withCredentials([file(credentialsId: 'corp-apigee-cicd-jenkins', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                        env.SA_TOKEN=sh(script:'gcloud auth application-default print-access-token', returnStdout: true).trim()
                    }
                }
            }
        }

        stage('Create Vertex AI Index') {
            when {
                expression { return params.CREATE_INDEX == true }
            }
            steps {
                sh """
                curl --location --request POST \
                "https://$REGION-aiplatform.googleapis.com/v1/projects/$PROJECT/locations/$REGION/indexes" \
                --header "Authorization: Bearer $SA_TOKEN" \
                --header 'Content-Type: application/json' \
                --data-raw \
                '{"displayName": "semantic-cache-index", "description": "semantic-cache-index", "metadata": {"config": {"dimensions": "768","approximateNeighborsCount": 150,"distanceMeasureType": "DOT_PRODUCT_DISTANCE","featureNormType": "NONE","algorithmConfig": {"treeAhConfig": {"leafNodeEmbeddingCount": "10000","fractionLeafNodesToSearch": 0.05}},"shardSize": "SHARD_SIZE_MEDIUM"},},"indexUpdateMethod": "STREAM_UPDATE"}'

                gcloud ai index-endpoints create \
                --display-name=semantic-cache-index-endpoint \
                --public-endpoint-enabled \
                --region=$REGION \
                --project=$PROJECT

                INDEX_ENDPOINT_ID=$(gcloud ai \
                index-endpoints list \
                --project=$PROJECT \
                --region=$REGION \
                --format="json" | jq -c -r \
                '.[] | select(.displayName="semantic-cache-index-endpoint") | .name | split("/") | .[5]' \
                ) && INDEX_ID=$(gcloud ai \
                indexes list \
                --project=$PROJECT \
                --region=$REGION \
                --format="json" | jq -c -r \
                '.[] | select(.displayName="semantic-cache-index") | .name | split("/") | .[5]' \
                ) && gcloud ai index-endpoints \
                deploy-index \
                $INDEX_ENDPOINT_ID \
                --deployed-index-id=semantic_cache_index_endpoint_deployment \
                --display-name=semantic-cache-index-endpoint-deployment \
                --index=$INDEX_ID \
                --region=$REGION \
                --project=$PROJECT

                echo $INDEX_ENDPOINT_ID
                """
            }
        }

        // stage('Deploy') {
        //     steps {
        //         script {
        //             dir('llm-semantic-cache-v2') {
        //                 sh './deploy-llm-semantic-cache-v2.sh'
        //             }
        //         }
        //     }
        // }
    }
}
